# Local dev defaults. Copy to services/social/.env — Prisma CLI reads it
# from this directory for `prisma migrate dev` and `prisma generate`.
# Inside docker, these values are overridden by docker-compose.yml.

DATABASE_URL=postgresql://football:changeme@localhost:5432/football
JWT_SECRET=changeme_minimum_32_chars_random
PORT=3000
ANALYZER_URL=http://localhost:8001

# Gate for /admin/* routes. Required in prod; in dev you can leave it blank
# and the admin routes will refuse to serve (403 AdminTokenNotConfigured).
ADMIN_TOKEN=dev_admin_token_at_least_16_chars
