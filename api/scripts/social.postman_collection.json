{
  "info": {
    "name": "football_core / social",
    "description": "Every request exercised by services/social/scripts/smoke.sh.\n\nRun the folders in order (Postman Runner). Each request captures IDs / tokens into collection variables, so later requests chain automatically.\n\n**Before running:** start the service (`cd services/social && npx tsx src/index.ts`) and reset the DB (`npx prisma migrate reset --force --skip-seed`) for a clean slate.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",       "value": "http://localhost:3000" },
    { "key": "admin_token",    "value": "dev_admin_token_at_least_16_chars" },
    { "key": "company_acme",   "value": "" },
    { "key": "company_gamma",  "value": "" },
    { "key": "team_scouts",    "value": "" },
    { "key": "team_analysts",  "value": "" },
    { "key": "team_observers", "value": "" },
    { "key": "user_alice",     "value": "" },
    { "key": "user_bob",       "value": "" },
    { "key": "user_carol",     "value": "" },
    { "key": "token_alice",    "value": "" },
    { "key": "token_bob",      "value": "" },
    { "key": "token_carol",    "value": "" },
    { "key": "analysis_id",    "value": "" }
  ],
  "item": [
    {
      "name": "0 Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('status=ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
